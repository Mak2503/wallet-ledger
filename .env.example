# Host-side development tools. Secret files are generated locally and ignored by git.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=wallet
DB_USER=wallet_app
DB_PASSWORD_FILE=./secrets/app_db_password
ADMIN_DB_USER=wallet_admin
ADMIN_DB_PASSWORD_FILE=./secrets/postgres_password

# Local reverse proxy / host access only. Keep DB_HOST_PORT loopback-bound.
POSTGRES_HOST_PORT=5433
API_HOST_BIND=127.0.0.1
API_HOST_PORT=8000
